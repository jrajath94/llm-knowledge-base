     "kind": "summary",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "SM",
     "definition": "Streaming multiprocessor; an H100 has 132.",
     "anchor": "chapter-1-the-gpu-execution-model-threads-warps-blocks-sms-p02"
    },
    {
     "term": "kernel",
     "definition": "One program launched as millions of copies, one per thread.",
     "anchor": "chapter-1-the-gpu-execution-model-threads-warps-blocks-sms-p02"
    },
    {
     "term": "warp",
     "definition": "Threads organized in warps and blocks under SMs.",
     "anchor": "chapter-1-the-gpu-execution-model-threads-warps-blocks-sms-p03"
    }
   ],
   "recall": [
    {
     "id": "chapter-1-the-gpu-execution-model-threads-warps-blocks-sms-r1",
     "question": "What is the GPU execution hierarchy?",
     "answer": "Threads in warps in blocks, run by SMs; you write one kernel, the GPU launches millions of copies.",
     "anchor": "chapter-1-the-gpu-execution-model-threads-warps-blocks-sms-p01"
    }
   ]
