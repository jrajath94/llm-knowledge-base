  {
   "anchor": "chapter-3-occupancy-and-latency-hiding",
   "title": "Chapter 3. Occupancy and latency hiding",
   "minutes": 8,
   "endAnchor": "chapter-3-occupancy-and-latency-hiding-end",
   "blocks": [
    {
     "anchor": "chapter-3-occupancy-and-latency-hiding-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "chapter-3-occupancy-and-latency-hiding-fig01",
     "kind": "figure",
     "reveal": "fade"
    },
    {
     "anchor": "chapter-3-occupancy-and-latency-hiding-takeaway",
     "kind": "summary",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "occupancy",
     "definition": "Fraction of an SM's warp slots holding live warps; 32 of 64 is 50%.",
     "anchor": "chapter-3-occupancy-and-latency-hiding-p01"
    },
    {
     "term": "latency hiding",
     "definition": "While one warp waits on a load, others compute.",
     "anchor": "chapter-3-occupancy-and-latency-hiding-p03"
    }
   ],
   "recall": [
    {
     "id": "chapter-3-occupancy-and-latency-hiding-r1",
     "question": "Why does occupancy matter?",
     "answer": "The GPU hides memory latency by swapping warps; an HBM read takes ~500 cycles.",
     "anchor": "chapter-3-occupancy-and-latency-hiding-p02"
    }
   ]
  },
