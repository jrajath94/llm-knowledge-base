  {
   "anchor": "lab-w14-d3-llm-inference-system-design",
   "title": "LLM Inference System Design Expert",
   "minutes": 3,
   "endAnchor": "lab-w14-d3-llm-inference-system-design-end",
   "blocks": [
    {
     "anchor": "lab-w14-d3-llm-inference-system-design-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    }
   ],
   "keyTerms": [
    {
     "term": "dynamic batching",
     "definition": "Wins because the GPU never idles on finished requests.",
     "anchor": "lab-w14-d3-llm-inference-system-design-p02"
    },
    {
     "term": "continuous batching",
     "definition": "Answer 'why' with the measured p95 gap, not adjectives.",
     "anchor": "lab-w14-d3-llm-inference-system-design-p02"
    }
   ],
   "recall": [
    {
     "id": "lab-w14-d3-llm-inference-system-design-r1",
     "question": "Why does dynamic batching win?",
     "answer": "Because the GPU never idles on finished requests; measured on p95 latency and throughput.",
     "anchor": "lab-w14-d3-llm-inference-system-design-p02"
    },
    {
     "id": "lab-w14-d3-llm-inference-system-design-r2",
     "question": "What is the simulator habit?",
     "answer": "When asked why continuous batching, answer with the measured p95 gap, not adjectives.",
     "anchor": "lab-w14-d3-llm-inference-system-design-p02"
    }
   ]
  },
