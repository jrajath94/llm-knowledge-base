   "anchor": "lab-w13-d1-ml-system-design-fundamentals",
   "title": "ML System Design Fundamentals Expert",
   "minutes": 7,
   "endAnchor": "lab-w13-d1-ml-system-design-fundamentals-end",
   "blocks": [
    {
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    }
   ],
   "keyTerms": [
    {
     "term": "seven steps",
     "definition": "The template: SLOs, metrics, data plan, modeling, serving, monitoring, tradeoffs.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p02"
    },
    {
     "term": "label-delay trap",
     "definition": "Watch for it in the data and labeling plan.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p02"
    },
    {
     "term": "false-decline rate",
     "definition": "Often decides whether a fraud model ships, not the model metric.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p03"
    },
    {
     "term": "guardrail metrics",
     "definition": "Business, model, and guardrail metrics after SLOs.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p02"
    }
   ],
   "recall": [
    {
     "id": "lab-w13-d1-ml-system-design-fundamentals-r1",
     "question": "What is the deliverable that matters most in interviews?",
     "answer": "Two tradeoffs you chose on purpose, from the final task.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p03"
    },
    {
     "id": "lab-w13-d1-ml-system-design-fundamentals-r2",
     "question": "What is the guardrail lesson?",
     "answer": "The false-decline rate, not the model metric, often decides whether a fraud model ships.",
     "anchor": "lab-w13-d1-ml-system-design-fundamentals-p03"
    }
   ]
  },
  {
   "anchor": "lab-w13-d2-feature-store-patterns",
   "title": "Feature Store Patterns Expert",
   "minutes": 4,
   "endAnchor": "lab-w13-d2-feature-store-patterns-end",
   "blocks": [
    {
     "anchor": "lab-w13-d2-feature-store-patterns-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    }
   ],
   "keyTerms": [
    {
     "term": "point-in-time correct",
     "definition": "Offline features computed without peeking at the future.",
     "anchor": "lab-w13-d2-feature-store-patterns-p02"
    },
    {
     "term": "skew check",
     "definition": "Compares what training saw against what serving would see.",
     "anchor": "lab-w13-d2-feature-store-patterns-p02"
    }
   ],
   "recall": [
    {
     "id": "lab-w13-d2-feature-store-patterns-r1",
     "question": "What is the lesson of the metric inflation?",
     "answer": "Without point-in-time correctness, your offline numbers are fiction.",
     "anchor": "lab-w13-d2-feature-store-patterns-p02"
    },
    {
     "id": "lab-w13-d2-feature-store-patterns-r2",
     "question": "What habit does this install?",
     "answer": "Never trust an offline metric until you can prove the pipeline computed features without peeking at the future.",
     "anchor": "lab-w13-d2-feature-store-patterns-p02"
    }
   ]
  },
  {
   "anchor": "lab-w13-d3-real-time-vs-batch-inference",
   "title": "Real-Time vs Batch Inference Expert",
   "minutes": 5,
   "endAnchor": "lab-w13-d3-real-time-vs-batch-inference-end",
   "blocks": [
    {
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-p01",
     "kind": "keyIdea",
     "reveal": "rise"
    },
    {
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-fig01",
     "kind": "figure",
     "reveal": "fade"
    }
   ],
   "keyTerms": [
    {
     "term": "latency-cost-freshness triangle",
     "definition": "Real-time catches spikes faster but costs more; batch is cheap but stale.",
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-p03"
    },
    {
     "term": "scoring policies",
     "definition": "Score immediately on spike events, or score in batches on a schedule.",
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-p02"
    }
   ],
   "recall": [
    {
     "id": "lab-w13-d3-real-time-vs-batch-inference-r1",
     "question": "What do you measure?",
     "answer": "Freshness against cost, for immediate scoring versus batched scoring on a simulated world.",
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-p02"
    },
    {
     "id": "lab-w13-d3-real-time-vs-batch-inference-r2",
     "question": "What is the shell-3 pattern?",
     "answer": "A cheap real-time heuristic for spikes plus a full batch rescore.",
     "anchor": "lab-w13-d3-real-time-vs-batch-inference-fig01"
    }
   ]
  },
  {
