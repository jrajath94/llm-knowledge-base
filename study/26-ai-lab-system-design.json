    }
   ],
   "recall": [
    {
     "id": "lab-w14-d1-design-real-time-recommendation-system-r1",
     "question": "What is the most reused pattern?",
     "answer": "Retrieval-then-ranking two-stage shape.",
     "anchor": "lab-w14-d1-design-real-time-recommendation-system-p04"
    },
    {
     "id": "lab-w14-d1-design-real-time-recommendation-system-r2",
     "question": "What does the retrieval stage return?",
     "answer": "About 1,000 candidates in under 50 ms.",
     "anchor": "lab-w14-d1-design-real-time-recommendation-system-p03"
    }
   ]
